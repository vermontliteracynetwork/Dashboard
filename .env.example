# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). See SETUP.md for the full walkthrough.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — the fixed account email the teacher password screen signs in
# with behind the scenes. Only change this if you want something other than
# the default; it just needs to match the one Auth user you create in Supabase.
VITE_TEACHER_EMAIL=teacher@independent-work-dashboard.local
