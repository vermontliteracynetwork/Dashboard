# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). See SETUP.md for the full walkthrough.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — the fixed account email the "Enter Teacher Area" button signs
# in with behind the scenes. Only change this if you want something other
# than the default; it just needs to match the one Auth user you create in
# Supabase.
VITE_TEACHER_EMAIL=teacher@independent-work-dashboard.local

# Required — the password on that same Supabase Auth user. There's no
# password prompt in the app anymore (one-tap "Enter Teacher Area"), but
# this still has to match what you set on the account in Supabase, or
# sign-in will fail silently with "Couldn't sign in."
VITE_TEACHER_INTERNAL_PASSWORD=pick-any-string-6-or-more-characters
